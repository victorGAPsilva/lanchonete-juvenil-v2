# Substitua pelo domínio apontado ao VPS (sem protocolo e sem barra final).
DOMAIN=seu-dominio.example
# Para execução Node direta, configure também a origem e caminhos persistentes.
PUBLIC_ORIGIN=https://seu-dominio.example
NODE_ENV=production
COOKIE_SECURE=true
HOST=0.0.0.0
PORT=3000
TRUST_PROXY_HOPS=1
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
BACKUP_DIR=/app/backups
