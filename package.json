{
  "name": "lanchonete-juvenil",
  "version": "1.1.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "demo": "node scripts/demo.js",
    "seed:examples": "node --env-file-if-exists=.env scripts/seed-examples.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.js",
    "preflight:live": "node --env-file-if-exists=.env scripts/preflight.js --live",
    "check": "node scripts/check-syntax.js && npm test && npm audit --omit=dev && npm run preflight",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5"
  }
}
